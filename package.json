{
  "name": "dao-den-long",
  "version": "0.1.0",
  "private": true,
  "description": "Dao Den Long - 3D third-person lantern game (Day 12 AI SDLC lab)",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
